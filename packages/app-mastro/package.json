{
  "name": "app-mastro",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server.ts",
    "build": "node node_modules/@mastrojs/mastro/src/generator.js",
    "type-check": "tsc"
  },
  "dependencies": {
    "@mastrojs/mastro": "jsr:0.8.10",
    "@remix-run/node-fetch-server": "^0.11"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^7"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.x",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "download"
    }
  }
}

    "@types/node": "25.9.1",
    "eslint": "10.4.0",
    "svelte": "5.55.9",
    "svelte-check": "4.4.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4",
    "vite": "8.0.14"
  }
}

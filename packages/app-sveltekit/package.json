    "@types/node": "26.1.1",
    "eslint": "10.7.0",
    "svelte": "5.56.4",
    "svelte-check": "4.7.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.4"
  }
}

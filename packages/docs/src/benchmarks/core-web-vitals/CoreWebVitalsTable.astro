---
import { cwvStats } from '../../lib/prepare-table'
import { getFrameworkSlug } from '../../lib/utils'
import StatsTable, { type TableColumn } from '../../components/StatsTable.astro'
import type { Device } from '../../lib/prepare-table'

interface Props {
  device: Device
}

const { device } = Astro.props

const columns = [
  {
    key: 'name',
    header: 'Framework',
    nameCell: true,
    alignment: 'left',
    href: (row: Record<string, unknown>) =>
      `/framework/${getFrameworkSlug(row.package as string)}`,
  },
  { key: 'lcpPercent', header: 'LCP%' },
  { key: 'clsPercent', header: 'CLS%' },
  { key: 'fcpPercent', header: 'FCP%' },
  { key: 'ttfbPercent', header: 'TTFB%' },
  { key: 'inpPercent', header: 'INP%' },
] satisfies TableColumn[]
---

<StatsTable
  label="CWV by framework"
  columns={columns}
  data={cwvStats(device)}
/>

---
import { starterHistory, starterStats } from '../../lib/prepare-chart'
import { monthlyComparison } from '../../lib/monthly-history'
import type { MetricDefinition } from '../../lib/types'
import StackedBarChart from '../../components/StackedBarChart.astro'
import { prepareDependencyStackedChart } from '../../lib/prepare-chart'
import StatsTable from '../../components/StatsTable.astro'
import {
  prepareFirstPartyDuplicateDependenciesTable,
  prepareFirstPartyDependenciesTable,
} from '../../lib/prepare-table'
import ViewSwitcher from '../../components/ViewSwitcher.astro'
import ComparisonBarChart from '../../components/ComparisonBarChart.astro'
import ComparisonLineChart from '../../components/ComparisonLineChart.astro'

type DependencyMetric =
  | 'totalDependencyCount'
  | 'developmentDependencyCount'
  | 'productionDependencyCount'
  | 'duplicateDependencyCount'

function getDependencyChartData(metric: DependencyMetric) {
  return starterStats
    .flatMap((framework) => {
      const value = framework.firstPartyDependencies[metric]?.value
      if (value == null || !Number.isFinite(value)) return []

      return [
        {
          name: framework.name,
          value,
          version: framework.frameworkVersion,
        },
      ]
    })
    .sort((a, b) => a.value - b.value || a.name.localeCompare(b.name))
}

function getDependencyCharts(metric: DependencyMetric, title: string) {
  const definition: MetricDefinition = {
    id: `firstPartyDependencies.${metric}`,
    title,
    valueFormat: 'count',
    yAxisLabel: 'Dependency count',
  }
  return {
    bar: { ...definition, data: getDependencyChartData(metric) },
    line: monthlyComparison(
      definition,
      starterHistory,
      starterStats,
      (record) => {
        const value = record.firstPartyDependencies?.[metric]?.value
        return value != null && Number.isFinite(value) ? value : null
      },
    ),
  }
}

const { bar, line } = getDependencyCharts(
  'duplicateDependencyCount',
  'First-Party Duplicate Dependencies',
)
const options = [
  { value: 'bar', label: 'Comparison' },
  { value: 'line', label: 'Over time' },
  { value: 'table', label: 'Table' },
]
const table = prepareFirstPartyDuplicateDependenciesTable(bar)

const chart1 = {
  title: 'First-Party Dependencies',
  ...prepareDependencyStackedChart('firstPartyDependencies'),
}
const chart1Table = prepareFirstPartyDependenciesTable(chart1)
---

<ViewSwitcher
  title={chart1.title}
  label={`${chart1.title} view`}
  options={[
    { value: 'chart', label: 'Comparison' },
    { value: 'table', label: 'Table' },
  ]}
  defaultValue="chart"
>
  <StackedBarChart slot="chart" {...chart1} />
  <StatsTable slot="table" {...chart1Table} />
</ViewSwitcher>
<ViewSwitcher
  title={bar.title}
  label={`${bar.title} chart type`}
  {options}
  defaultValue="bar"
>
  <ComparisonBarChart slot="bar" {...bar} />
  <ComparisonLineChart slot="line" {...line} />
  <StatsTable slot="table" {...table} />
</ViewSwitcher>

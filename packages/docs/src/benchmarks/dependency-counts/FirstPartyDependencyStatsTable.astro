---
import { firstPartyDepsStats } from '../../lib/prepare-table'
import { getFrameworkSlug } from '../../lib/utils'
import StatsTable, { type TableColumn } from '../../components/StatsTable.astro'

const firstPartyDependencyColumns = [
  {
    key: 'name',
    header: 'Framework',
    nameCell: true,
    alignment: 'left',
    href: (row: Record<string, unknown>) =>
      `/framework/${getFrameworkSlug(row.package as string)}`,
  },
  { key: 'directDependencies', header: 'Deps Dev / Prod' },
  { key: 'allDependencies', header: 'All Deps' },
  { key: 'duplicateDependencies', header: 'Dup. Deps' },
  {
    key: 'graph',
    header: 'Graph',
    href: (row: Record<string, unknown>) =>
      `https://npmgraph.js.org/?q=https://github.com/e18e/framework-tracker/blob/main/packages/${row.package}/first-party-dependencies.json`,
  },
] satisfies TableColumn[]
---

<StatsTable
  label="First-party dependency counts by meta-framework"
  columns={firstPartyDependencyColumns}
  data={firstPartyDepsStats}
/>

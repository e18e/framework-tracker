---
import type { ChartMeasurement } from '../../lib/types'
import {
  prepareDependencyHistoryChart,
  prepareDuplicateDependenciesHistory,
} from '../../lib/prepare-chart'
import VersionLineChart from '../../components/VersionLineChart.astro'
import StackedAreaChart from '../../components/StackedAreaChart.astro'

interface Props {
  versions: ChartMeasurement[]
}

const { versions } = Astro.props
---

<StackedAreaChart
  title="Core Package Dependencies"
  {...prepareDependencyHistoryChart(versions, 'frameworkDependencies')}
/>
<StackedAreaChart
  title="First-Party Dependencies"
  {...prepareDependencyHistoryChart(versions, 'firstPartyDependencies')}
/>
<StackedAreaChart
  title="Starter Dependencies"
  {...prepareDependencyHistoryChart(versions)}
/>
<VersionLineChart {...prepareDuplicateDependenciesHistory(versions)} />

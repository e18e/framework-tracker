---
import { depsStats } from '../../lib/prepare-table'
import { getFrameworkSlug } from '../../lib/utils'
import StatsTable, { type TableColumn } from '../../components/StatsTable.astro'

const depsColumns = [
  {
    key: 'name',
    header: 'Framework',
    nameCell: true,
    alignment: 'left',
    href: (row: Record<string, unknown>) =>
      `/framework/${getFrameworkSlug(row.package as string)}`,
  },
  { key: 'directDependencies', header: 'Deps Dev / Prod' },
  { key: 'allDependencies', header: 'All Deps' },
  { key: 'duplicateDependencies', header: 'Dup. Deps' },
  { key: 'nodeModulesSize', header: 'node_modules' },
  { key: 'depInstallSize', header: 'Dep Install Size' },
  {
    key: 'graph',
    header: 'Graph',
    href: (row: Record<string, unknown>) =>
      `https://npmgraph.js.org/?q=https://github.com/e18e/framework-tracker/blob/main/packages/${row.package}/package.json`,
  },
] satisfies TableColumn[]
---

<StatsTable
  label="Dependency counts by starter project"
  columns={depsColumns}
  data={depsStats}
/>

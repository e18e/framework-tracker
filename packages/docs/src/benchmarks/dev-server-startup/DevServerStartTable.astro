---
import { devServerStartData } from '../../lib/prepare-table'
import { getFrameworkSlug } from '../../lib/utils'
import StatsTable, { type TableColumn } from '../../components/StatsTable.astro'

const columns = [
  {
    key: 'name',
    header: 'Framework',
    nameCell: true,
    alignment: 'left',
    href: (row: Record<string, unknown>) =>
      `/framework/${getFrameworkSlug(row.package as string)}`,
  },
  { key: 'medianStart', header: 'Median Start' },
  { key: 'minStart', header: 'Min Start' },
  { key: 'maxStart', header: 'Max Start' },
] satisfies TableColumn[]
---

<StatsTable
  label="Dev server startup time by framework"
  columns={columns}
  data={devServerStartData}
/>

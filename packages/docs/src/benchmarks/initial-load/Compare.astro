---
import {
  prepareInitialLoadTable,
  prepareInitialLoadWithoutJavaScriptTable,
} from '../../lib/prepare-table'
import StatsTable from '../../components/StatsTable.astro'
import ViewSwitcher from '../../components/ViewSwitcher.astro'
import { Content as Description } from './Description.mdx'
import {
  initialLoadChartData,
  initialLoadSeries,
} from '../../lib/prepare-chart'
import StackedBarChart from '../../components/StackedBarChart.astro'

const chart1 = {
  title: 'Initial Load: All Resources',
  series: initialLoadSeries,
  data: initialLoadChartData,
}
const chart1Table = prepareInitialLoadTable(chart1)

const chart2 = {
  title: 'Initial Load: Excluding JavaScript',
  series: initialLoadSeries.filter((item) => item.key !== 'js'),
  data: initialLoadChartData,
}
const chart2Table = prepareInitialLoadWithoutJavaScriptTable(chart2)
---

<Description />
<ViewSwitcher
  title={chart1.title}
  label={`${chart1.title} view`}
  options={[
    { value: 'chart', label: 'Comparison' },
    { value: 'table', label: 'Table' },
  ]}
  defaultValue="chart"
>
  <StackedBarChart slot="chart" {...chart1} />
  <StatsTable slot="table" {...chart1Table} />
</ViewSwitcher>
<ViewSwitcher
  title={chart2.title}
  label={`${chart2.title} view`}
  options={[
    { value: 'chart', label: 'Comparison' },
    { value: 'table', label: 'Table' },
  ]}
  defaultValue="chart"
>
  <StackedBarChart slot="chart" {...chart2} />
  <StatsTable slot="table" {...chart2Table} />
</ViewSwitcher>

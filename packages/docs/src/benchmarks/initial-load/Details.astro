---
import type { InitialLoadStats } from '@framework-tracker/results'
import { Content as Description } from './Description.mdx'
import StackedAreaChart from '../../components/StackedAreaChart.astro'
import { initialLoadSeries } from '../../lib/prepare-chart'
import { prepareInitialLoadResources } from '../../lib/initial-load'
interface Props {
  versions: { frameworkVersion?: string; initialLoadTests?: InitialLoadStats }[]
}
const data = Astro.props.versions.flatMap((version) => {
  const resources = version.initialLoadTests?.resources
  if (!resources) return []
  const values = prepareInitialLoadResources(resources)
  return [
    {
      name: version.frameworkVersion ?? '',
      values,
      total: Object.values(values).reduce((a, b) => a + b, 0),
    },
  ]
})
const withoutJs = data.map((datum) => ({
  ...datum,
  total: datum.total - datum.values.js,
}))
---

<Description />
<StackedAreaChart
  title="Initial Load: All Resources by Version"
  data={data}
  series={initialLoadSeries}
  valueFormat="kb"
  yAxisLabel="Transfer size (KB)"
/>
<StackedAreaChart
  title="Initial Load: Excluding JavaScript by Version"
  data={withoutJs}
  series={initialLoadSeries.filter(({ key }) => key !== 'js')}
  valueFormat="kb"
  yAxisLabel="Transfer size (KB)"
/>

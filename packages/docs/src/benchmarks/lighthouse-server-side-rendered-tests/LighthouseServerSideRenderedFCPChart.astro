---
import {
  prepareLighthouseServerSideRenderedTestsFcpMsComparison,
  prepareLighthouseServerSideRenderedTestsFcpMsMonthlyComparison,
  runtimeHistory,
  ssrRequestThroughputStats,
} from '../../lib/prepare-chart'
import StatsTable from '../../components/StatsTable.astro'
import { prepareServerRenderedFCPTable } from '../../lib/prepare-table'
import ViewSwitcher from '../../components/ViewSwitcher.astro'
import ComparisonBarChart from '../../components/ComparisonBarChart.astro'
import ComparisonLineChart from '../../components/ComparisonLineChart.astro'

const bar = prepareLighthouseServerSideRenderedTestsFcpMsComparison(
  ssrRequestThroughputStats,
)
const line = prepareLighthouseServerSideRenderedTestsFcpMsMonthlyComparison(
  runtimeHistory,
  ssrRequestThroughputStats,
)

const hasVariance = bar.data.some((datum) => datum.range)
const options = [
  { value: 'bar', label: 'Comparison' },
  ...(hasVariance ? [{ value: 'variance', label: 'Variance' }] : []),
  { value: 'line', label: 'Over time' },
  { value: 'table', label: 'Table' },
]
const table = prepareServerRenderedFCPTable(bar)
---

<ViewSwitcher
  title={bar.title}
  label={`${bar.title} chart type`}
  {options}
  defaultValue="bar"
>
  <ComparisonBarChart slot="bar" {...bar} />
  <Fragment slot="variance">
    {hasVariance && <ComparisonBarChart {...bar} view="variance" />}
  </Fragment>
  <ComparisonLineChart slot="line" {...line} />
  <StatsTable slot="table" {...table} />
</ViewSwitcher>

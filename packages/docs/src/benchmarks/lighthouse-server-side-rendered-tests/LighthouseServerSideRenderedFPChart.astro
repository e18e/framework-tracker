---
import {
  prepareLighthouseServerSideRenderedTestsFirstPaintMsComparison,
  prepareLighthouseServerSideRenderedTestsFirstPaintMsMonthlyComparison,
  runtimeHistory,
  ssrRequestThroughputStats,
} from '../../lib/prepare-chart'
import ViewSwitcher from '../../components/ViewSwitcher.astro'
import ComparisonBarChart from '../../components/ComparisonBarChart.astro'
import ComparisonLineChart from '../../components/ComparisonLineChart.astro'

const bar = prepareLighthouseServerSideRenderedTestsFirstPaintMsComparison(
  ssrRequestThroughputStats,
)
const line =
  prepareLighthouseServerSideRenderedTestsFirstPaintMsMonthlyComparison(
    runtimeHistory,
    ssrRequestThroughputStats,
  )

const hasVariance = bar.data.some((datum) => datum.range)
const options = [
  { value: 'bar', label: 'Comparison' },
  ...(hasVariance ? [{ value: 'variance', label: 'Variance' }] : []),
  { value: 'line', label: 'Over time' },
]
---

<ViewSwitcher
  title={bar.title}
  label={`${bar.title} chart type`}
  {options}
  defaultValue="bar"
>
  <ComparisonBarChart slot="bar" {...bar} />
  <Fragment slot="variance">
    {hasVariance && <ComparisonBarChart {...bar} view="variance" />}
  </Fragment>
  <ComparisonLineChart slot="line" {...line} />
</ViewSwitcher>

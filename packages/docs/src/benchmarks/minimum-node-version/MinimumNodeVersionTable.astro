---
import { minimumNodeVersionTableData } from '../../lib/prepare-table'
import { getFrameworkSlug } from '../../lib/utils'
import StatsTable, { type TableColumn } from '../../components/StatsTable.astro'

const columns = [
  {
    key: 'name',
    header: 'Framework',
    href: (row: Record<string, unknown>) =>
      `/framework/${getFrameworkSlug(row.package as string)}`,
    nameCell: true,
    alignment: "left"
  },
  { key: 'minNodeVersion', header: 'Min Node' },
  { key: 'imposedBy', header: 'Set by', alignment: "left"  },
] satisfies TableColumn[]
---

<StatsTable
  label="Minimum Node version by framework"
  columns={columns}
  data={minimumNodeVersionTableData}
/>

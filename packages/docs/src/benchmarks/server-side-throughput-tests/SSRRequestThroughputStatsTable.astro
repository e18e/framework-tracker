---
import { requestThroughputTableData } from '../../lib/prepare-table'
import { getFrameworkSlug } from '../../lib/utils'
import StatsTable, { type TableColumn } from '../../components/StatsTable.astro'

const columns = [
  {
    key: 'name',
    header: 'Framework',
    nameCell: true,
    alignment: 'left',
    href: (row: Record<string, unknown>) =>
      row.package !== 'app-baseline-html'
        ? `/framework/${getFrameworkSlug(row.package as string)}`
        : null,
  },
  { key: 'opsPerSec', header: 'Ops/sec' },
  { key: 'latencyMs', header: 'Median Latency' },
  { key: 'bodySizeKb', header: 'Body Size' },
  { key: 'duplicationFactor', header: 'Duplication' },
] satisfies TableColumn[]
---

<StatsTable
  label="SSR request throughput by framework"
  columns={columns}
  data={requestThroughputTableData}
/>

---
import StackedAreaChart from '../../components/StackedAreaChart.astro'
import { INTERACTION_PHASES } from '../../lib/interaction-phases'
import type { InteractionHistoryDatum } from '../../lib/types'
import InteractionChartCaption from './InteractionChartCaption.astro'

interface Props {
  title: string
  data: InteractionHistoryDatum[]
}

const { title, data } = Astro.props
---

<StackedAreaChart
  {title}
  data={data.map((datum) => ({
    name: datum.name,
    total: datum.interactionLatencyMs,
    values: Object.fromEntries(
      INTERACTION_PHASES.map(({ key }) => [key, datum[key]]),
    ),
  }))}
  series={INTERACTION_PHASES.map(({ key, label, colorVar }) => ({
    key,
    label,
    color: `var(${colorVar})`,
  }))}
  valueFormat="ms"
  yAxisLabel="Interaction latency (ms)"
>
  <InteractionChartCaption slot="caption" {title} />
</StackedAreaChart>

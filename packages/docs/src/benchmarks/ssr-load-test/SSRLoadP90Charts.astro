---
import {
  prepareSSRLatencyByConnections,
  ssrRequestThroughputStats,
  type SSRLoadKey,
} from '../../lib/prepare-chart'
import ChartTitle from '../../components/ChartTitle.astro'
import ComparisonLineChart from '../../components/ComparisonLineChart.astro'
interface Props {
  testsKey?: SSRLoadKey
}
const { testsKey = 'ssrLoadTests' } = Astro.props
const byConnections = prepareSSRLatencyByConnections(
  ssrRequestThroughputStats,
  'p90LatencyMs',
  testsKey,
)
---

<ChartTitle>{byConnections.title}</ChartTitle>
<ComparisonLineChart {...byConnections} />

---
import { prepareSSRLoadP90Table } from '../../lib/prepare-table'
import StatsTable from '../../components/StatsTable.astro'
import ViewSwitcher from '../../components/ViewSwitcher.astro'
import {
  prepareSSRLatencyByConnections,
  ssrRequestThroughputStats,
  type SSRLoadKey,
} from '../../lib/prepare-chart'
import ComparisonLineChart from '../../components/ComparisonLineChart.astro'
interface Props {
  testsKey?: SSRLoadKey
}
const { testsKey = 'ssrLoadTests' } = Astro.props
const byConnections = prepareSSRLatencyByConnections(
  ssrRequestThroughputStats,
  'p90LatencyMs',
  testsKey,
)

const chart1 = { ...byConnections }
const chart1Table = prepareSSRLoadP90Table(chart1)
---

<ViewSwitcher
  label={`${chart1.title} view`}
  options={[
    { value: 'chart', label: 'Comparison' },
    { value: 'table', label: 'Table' },
  ]}
  defaultValue="chart"
>
  <ComparisonLineChart slot="chart" {...chart1} />
  <StatsTable slot="table" {...chart1Table} />
</ViewSwitcher>

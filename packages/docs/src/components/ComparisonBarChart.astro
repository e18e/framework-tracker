---
import { formatChartValue, getComparisonChartHeight } from '../lib/chart'
import type { ChartDatum, ChartValueFormat } from '../lib/types'

interface Props {
  id?: string
  title: string
  description?: string
  data: ChartDatum[]
  valueFormat: ChartValueFormat
  yAxisLabel: string
}

const { id, title, description, data, valueFormat, yAxisLabel } = Astro.props
const chartData = data.map((d) => ({
  id: d.id,
  name: String(d?.name ?? ''),
  value: Math.max(0, Number(d.value) || 0),
  focused: d.focused,
  version: d.version,
}))
const chartHeight = getComparisonChartHeight(chartData.length)

const chartPayload = JSON.stringify({
  id,
  data: chartData,
  valueFormat,
  yAxisLabel,
  title,
})
---

<div class="comparison-chart">
  <h3 class="comparison-chart-title">{title}</h3>
  {description ? <p>{description}</p> : null}
  <div
    class="comparison-chart-wrapper"
    data-comparison={chartPayload}
    style={`--comparison-chart-height: ${chartHeight}px`}
  >
    <div class="comparison-chart-host"></div>
    <div class="comparison-logo-layer" aria-hidden="true"></div>
    <svg class="comparison-median-defs" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient gradientUnits="userSpaceOnUse" x1="0" x2="0"
        ></linearGradient>
      </defs>
    </svg>
    <div class="comparison-chart-data sr-only">
      <table aria-label={`${title} data`}>
        <caption>{title} data</caption>
        <thead>
          <tr>
            <th scope="col">Framework</th>
            <th scope="col">{yAxisLabel}</th>
          </tr>
        </thead>
        <tbody>
          {
            chartData.map((datum) => (
              <tr data-focused={datum.focused === false ? 'false' : 'true'}>
                <th scope="row">{datum.name}</th>
                <td>{formatChartValue(datum.value, valueFormat)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p>
        The chart includes a dotted median reference line calculated from the
        visible framework values.
      </p>
    </div>
  </div>
</div>

<style>
  .comparison-chart {
    width: 100%;
    margin-bottom: 2em;
  }

  .comparison-chart-title {
    font-size: 16px;
  }

  .comparison-chart-wrapper {
    position: relative;
    width: 100%;
    min-height: var(--comparison-chart-height);
    color: var(--ft-text, #1f2933);
  }

  .comparison-chart-wrapper :global(.ts-chart:focus:not(:focus-visible)) {
    outline: none;
  }

  .comparison-logo-layer {
    position: absolute;
    inset: 0;
    margin: 0;
    pointer-events: none;
    z-index: 1;
  }

  .comparison-median-defs {
    position: absolute;
    width: 0;
    height: 0;
    margin: 0;
    overflow: hidden;
  }

  .comparison-chart-wrapper :global(.comparison-logo) {
    position: absolute;
    width: 20px;
    height: 20px;
    margin: 0;
    transform: translate(-100%, -50%);
  }

  .comparison-chart-wrapper :global(.comparison-logo-fallback) {
    display: grid;
    place-items: center;
    font:
      700 12px system-ui,
      sans-serif;
  }

  :global([data-framework-scope='focused'])
    .comparison-chart-data
    tr[data-focused='false'] {
    display: none;
  }
</style>

<script>
  import {
    barX,
    defineChart,
    mountChart,
    ruleX,
    text,
    type ChartHost,
    type ChartRenderContext,
  } from '@tanstack/charts'
  import { scaleBand } from '@tanstack/charts/scales/band'
  import { scaleLinear } from '@tanstack/charts/scales/linear'
  import { decorative } from '@tanstack/charts/mark/decorative'
  import { tooltip } from '@tanstack/charts/tooltip'
  import {
    formatChartValue,
    getComparisonChartHeight,
    getFrameworkLogoSource,
  } from '../lib/chart'
  import type { ChartDatum, ComparisonChartPayload } from '../lib/types'

  type Payload = ComparisonChartPayload & { title: string }
  type RenderContext = ChartRenderContext<ChartDatum, number, string>

  const BAR_COLOR = '#c0b9dd'
  const BAR_HOVER_COLOR = '#b2a8d8'
  const MEDIAN_COLORS = ['#ec8f5e', '#f2ca60', '#bece57', '#7bb560']
  const LOGO_SIZE = 20
  const LOGO_MARGIN = LOGO_SIZE + 16
  const MEDIAN_LABEL_MARGIN = 24
  const MEDIAN_LABEL_GAP = 12
  const BAND_PADDING = 0.18
  const hosts = new WeakMap<
    HTMLElement,
    ChartHost<ChartDatum, number, string>
  >()

  let medianGradientCount = 0

  function getCssVar(name: string, fallback: string) {
    return (
      getComputedStyle(document.documentElement)
        .getPropertyValue(name)
        .trim() || fallback
    )
  }

  function getMedian(values: number[]) {
    const sorted = [...values].sort((a, b) => a - b)
    const mid = Math.floor(sorted.length / 2)
    return sorted.length % 2 === 0
      ? (sorted[mid - 1]! + sorted[mid]!) / 2
      : sorted[mid]!
  }

  function renderLogoLayer(wrapper: HTMLElement, names: string[]) {
    const layer = wrapper.querySelector<HTMLElement>('.comparison-logo-layer')!
    layer.style.visibility = 'hidden'
    layer.replaceChildren(
      ...names.map((name) => {
        const source = getFrameworkLogoSource(name)
        if (source == null) {
          const fallback = document.createElement('span')
          fallback.className = 'comparison-logo comparison-logo-fallback'
          fallback.textContent = name.slice(0, 1) || '?'
          fallback.title = name
          return fallback
        }
        const logo = document.createElement('img')
        logo.className = 'comparison-logo'
        logo.src = source
        logo.alt = name
        logo.title = name
        logo.width = LOGO_SIZE
        logo.height = LOGO_SIZE
        return logo
      }),
    )
    return layer
  }

  function positionLogos(
    layer: HTMLElement,
    names: string[],
    { scene }: RenderContext,
  ) {
    const yScale = scene.scales.y
    if (!yScale) return
    Array.from(layer.children).forEach((child, index) => {
      const logo = child as HTMLElement
      logo.style.top = `${yScale.map(names[index])}px`
      logo.style.left = `${scene.chart.x - 8}px`
    })
    layer.style.visibility = 'visible'
  }

  function setupMedianGradient(wrapper: HTMLElement) {
    const gradient = wrapper.querySelector('linearGradient')!
    if (!gradient.id) {
      gradient.id = `comparison-median-gradient-${++medianGradientCount}`
      gradient.replaceChildren(
        ...MEDIAN_COLORS.map((_, index) => {
          const stop = document.createElementNS(
            'http://www.w3.org/2000/svg',
            'stop',
          )
          stop.setAttribute(
            'offset',
            String(index / (MEDIAN_COLORS.length - 1)),
          )
          stop.setAttribute(
            'stop-color',
            MEDIAN_COLORS[MEDIAN_COLORS.length - 1 - index]!,
          )
          return stop
        }),
      )
    }
    return gradient
  }

  function positionMedianGradient(
    gradient: SVGLinearGradientElement,
    { scene }: RenderContext,
  ) {
    gradient.setAttribute('y1', String(scene.chart.y))
    gradient.setAttribute('y2', String(scene.chart.y + scene.chart.height))
  }

  function getPayload(wrapper: HTMLElement): Payload | null {
    const dataAttr = wrapper.dataset.comparison
    if (!dataAttr) return null

    try {
      return JSON.parse(dataAttr) as Payload
    } catch (e) {
      console.warn('[ComparisonBarChart] Invalid chart data:', e)
      return null
    }
  }

  function initChart(wrapper: HTMLElement) {
    const payload = getPayload(wrapper)
    if (!payload) return

    const format = (value: number, prefix?: boolean) =>
      formatChartValue(value, payload.valueFormat, prefix)

    const scopedParent = wrapper.closest<HTMLElement>('[data-framework-scope]')
    const focusedOnly = scopedParent?.dataset.frameworkScope === 'focused'
    const rows = payload.data.filter((d) => !focusedOnly || d.focused !== false)
    if (rows.length === 0) return

    const values = rows.map((d) => d.value)
    const max = Math.max(...values)
    const median = getMedian(values)
    const height = getComparisonChartHeight(rows.length)
    wrapper.style.setProperty('--comparison-chart-height', `${height}px`)

    const barColor = getCssVar('--ft-chart-bar', BAR_COLOR)
    const barHoverColor = getCssVar('--ft-chart-bar-hover', BAR_HOVER_COLOR)
    const mutedColor = getCssVar('--ft-muted', '#697586')
    const accentColor = getCssVar(
      '--sl-color-text-accent',
      getCssVar('--ft-text', '#1f2933'),
    )

    const names = rows.map((d) => d.name)
    const logoLayer = renderLogoLayer(wrapper, names)
    const medianGradient = setupMedianGradient(wrapper)

    const definition = defineChart({
      margin: { left: LOGO_MARGIN, top: MEDIAN_LABEL_MARGIN, bottom: 0 },
      focusRing: false,
      marks: [
        barX(rows, {
          id: 'values',
          x: 'value',
          y: 'name',
          fill: barColor,
          radius: 8,
          inset: 3,
          states: [
            {
              when: { focus: 'primary' },
              style: { fill: barHoverColor },
              transition: { type: 'tween', duration: 140, easing: 'ease-out' },
            },
          ],
        }),
        ruleX([median], {
          id: 'median',
          stroke: `url(#${medianGradient.id})`,
          strokeOpacity: 1,
          strokeWidth: 3,
          strokeDasharray: '5 4',
        }),
        decorative(
          text([median], {
            id: 'median-label',
            x: (d) => d,
            y: () => rows[0]!.name,
            dy: () => {
              const step =
                (height - MEDIAN_LABEL_MARGIN) / (rows.length + BAND_PADDING)
              const firstBandCenter =
                step * (BAND_PADDING + (1 - BAND_PADDING) / 2)
              return -(firstBandCenter + MEDIAN_LABEL_GAP)
            },
            text: () => `Median: ${format(median)}`,
            fill: accentColor,
            fontWeight: 600,
            fontSize: 13,
            anchor: 'middle',
          }),
        ),
        text(rows, {
          id: 'value-labels',
          x: 'value',
          y: 'name',
          text: (d) => format(d.value),
          fill: mutedColor,
          fontWeight: 600,
          fontSize: 13,
          anchor: 'start',
          dx: 10,
        }),
      ],
      scales: {
        x: {
          scale: () => scaleLinear().domain([0, max > 0 ? max * 1.15 : 1]),
          axis: false,
        },
        y: {
          scale: () =>
            scaleBand<string>()
              .domain(rows.map((d) => d.name))
              .padding(BAND_PADDING),
          axis: false,
        },
      },
      tooltip: {
        use: tooltip,
        content: (points) => {
          const datum = points[0]!.datum
          return {
            title: datum.version
              ? `${datum.name}: v${datum.version}`
              : datum.name,
            rows: [
              { label: payload.yAxisLabel, value: format(datum.value) },
              {
                label: 'Median',
                value: format(datum.value - median, true),
              },
            ],
          }
        },
      },
    })

    const options = {
      definition,
      height,
      ariaLabel: `${payload.title}. Horizontal bar chart; a data table follows.`,
      onRender: (context: RenderContext) => {
        positionLogos(logoLayer, names, context)
        positionMedianGradient(medianGradient, context)
      },
    }

    const existing = hosts.get(wrapper)
    if (existing) {
      existing.update(options)
    } else {
      hosts.set(
        wrapper,
        mountChart(
          wrapper.querySelector<HTMLElement>('.comparison-chart-host')!,
          options,
        ),
      )
    }
  }

  function initCharts() {
    document
      .querySelectorAll<HTMLElement>('.comparison-chart-wrapper')
      .forEach(initChart)
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCharts)
  } else {
    initCharts()
  }

  new MutationObserver(() => requestAnimationFrame(initCharts)).observe(
    document.documentElement,
    { attributeFilter: ['class', 'data-theme'], attributes: true },
  )
</script>

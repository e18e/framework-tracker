---
import { coreJsTableData } from '../lib/collections'
import { getFrameworkSlug } from '../lib/utils'
import StatsTable from './StatsTable.astro'

const columns = [
  {
    key: 'name',
    header: 'Framework',
    nameCell: true,
    href: (row: Record<string, unknown>) =>
      `/framework/${getFrameworkSlug(row.package as string)}`,
  },
  { key: 'detected', header: 'Core-JS detected' },
  { key: 'bundledSize', header: 'Matching JS files' },
  {
    key: 'unnecessaryModules',
    header: 'Modules not needed by target browsers',
  },
]
---

<StatsTable
  label="Core-JS signatures in build output by framework"
  columns={columns}
  data={coreJsTableData}
/>

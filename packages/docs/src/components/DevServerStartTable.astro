---
import { devServerStartData } from '../lib/collections'
import { getFrameworkSlug } from '../lib/utils'
import StatsTable from './StatsTable.astro'

const columns = [
  {
    key: 'name',
    header: 'Framework',
    nameCell: true,
    href: (row: Record<string, unknown>) =>
      `/framework/${getFrameworkSlug(row.package as string)}`,
  },
  { key: 'avgStart', header: 'Avg Start' },
  { key: 'minStart', header: 'Min Start' },
  { key: 'maxStart', header: 'Max Start' },
]
---

<StatsTable
  label="Dev server startup time by framework"
  columns={columns}
  data={devServerStartData}
/>

---
import { starterStats } from '../lib/collections'
import { BYTES_PER_MB } from '../lib/utils'
import ComparisonBarChart from './ComparisonBarChart.astro'

type DependencyMetric =
  | 'allDependencies'
  | 'devDependencies'
  | 'prodDependencies'
  | 'duplicateDependencies'

function getDependencyChartData(metric: DependencyMetric) {
  return starterStats
    .flatMap((framework) => {
      const value = framework.firstPartyDependencies[metric]
      if (typeof value !== 'number' || !Number.isFinite(value)) return []

      return [
        {
          name: framework.name,
          value,
          focused: framework.isFocused,
        },
      ]
    })
    .sort((a, b) => a.value - b.value || a.name.localeCompare(b.name))
}

const installSizeData = starterStats
  .flatMap((framework) => {
    const bytes = framework.firstPartyDependencies.depInstallSize
    if (typeof bytes !== 'number' || !Number.isFinite(bytes)) return []

    return [
      {
        name: framework.name,
        value: bytes / BYTES_PER_MB,
        focused: framework.isFocused,
      },
    ]
  })
  .sort((a, b) => a.value - b.value || a.name.localeCompare(b.name))
---

<ComparisonBarChart
  title="Meta-framework Direct Package Dependencies"
  data={getDependencyChartData('allDependencies')}
  valueFormat="count"
  yAxisLabel="Dependency count"
/>
<ComparisonBarChart
  title="Meta-framework Direct Package Development Dependencies"
  data={getDependencyChartData('devDependencies')}
  valueFormat="count"
  yAxisLabel="Dependency count"
/>
<ComparisonBarChart
  title="Meta-framework Direct Package Production Dependencies"
  data={getDependencyChartData('prodDependencies')}
  valueFormat="count"
  yAxisLabel="Dependency count"
/>
<ComparisonBarChart
  title="Meta-framework Direct Package Duplicate Dependencies"
  data={getDependencyChartData('duplicateDependencies')}
  valueFormat="count"
  yAxisLabel="Dependency count"
/>
<ComparisonBarChart
  title="Meta-framework Direct Package Install Size"
  data={installSizeData}
  valueFormat="mb"
  yAxisLabel="Megabytes"
/>

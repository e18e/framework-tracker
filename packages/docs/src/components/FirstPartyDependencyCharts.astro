---
import { starterHistory, starterStats } from '../lib/prepare-chart'
import { monthlyComparison } from '../lib/monthly-history'
import type { MetricDefinition } from '../lib/types'
import ComparisonComposition from './ComparisonComposition.astro'

type DependencyMetric =
  | 'allDependencies'
  | 'devDependencies'
  | 'prodDependencies'
  | 'duplicateDependencies'

function getDependencyChartData(metric: DependencyMetric) {
  return starterStats
    .flatMap((framework) => {
      const value = framework.firstPartyDependencies[metric]
      if (typeof value !== 'number' || !Number.isFinite(value)) return []

      return [
        {
          name: framework.name,
          value,
          focused: framework.isFocused,
          version: framework.frameworkVersion,
        },
      ]
    })
    .sort((a, b) => a.value - b.value || a.name.localeCompare(b.name))
}

function getDependencyCharts(metric: DependencyMetric, title: string) {
  const definition: MetricDefinition = {
    id: `firstPartyDependencies.${metric}`,
    title,
    valueFormat: 'count',
    yAxisLabel: 'Dependency count',
  }
  return {
    bar: { ...definition, data: getDependencyChartData(metric) },
    line: monthlyComparison(
      definition,
      starterHistory,
      starterStats,
      (record) => {
        const value = record.firstPartyDependencies?.[metric]
        return typeof value === 'number' && Number.isFinite(value)
          ? value
          : null
      },
    ),
  }
}
---

<ComparisonComposition
  {...getDependencyCharts('allDependencies', 'First-Party Dependencies')}
/>
<ComparisonComposition
  {...getDependencyCharts(
    'devDependencies',
    'First-Party Development Dependencies',
  )}
/>
<ComparisonComposition
  {...getDependencyCharts(
    'prodDependencies',
    'First-Party Production Dependencies',
  )}
/>
<ComparisonComposition
  {...getDependencyCharts(
    'duplicateDependencies',
    'First-Party Duplicate Dependencies',
  )}
/>

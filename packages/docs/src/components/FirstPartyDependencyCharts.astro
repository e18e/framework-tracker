---
import { starterStats } from '../lib/prepare-chart'
import ComparisonBarChart from './ComparisonBarChart.astro'

type DependencyMetric =
  | 'allDependencies'
  | 'devDependencies'
  | 'prodDependencies'
  | 'duplicateDependencies'

function getDependencyChartData(metric: DependencyMetric) {
  return starterStats
    .flatMap((framework) => {
      const value = framework.firstPartyDependencies[metric]
      if (typeof value !== 'number' || !Number.isFinite(value)) return []

      return [
        {
          name: framework.name,
          value,
          focused: framework.isFocused,
          version: framework.frameworkVersion,
        },
      ]
    })
    .sort((a, b) => a.value - b.value || a.name.localeCompare(b.name))
}
---

<ComparisonBarChart
  title="Meta-framework First Party Package Dependencies"
  data={getDependencyChartData('allDependencies')}
  valueFormat="count"
  yAxisLabel="Dependency count"
/>
<ComparisonBarChart
  title="Meta-framework First Party Package Development Dependencies"
  data={getDependencyChartData('devDependencies')}
  valueFormat="count"
  yAxisLabel="Dependency count"
/>
<ComparisonBarChart
  title="Meta-framework First Party Package Production Dependencies"
  data={getDependencyChartData('prodDependencies')}
  valueFormat="count"
  yAxisLabel="Dependency count"
/>
<ComparisonBarChart
  title="Meta-framework First Party Package Duplicate Dependencies"
  data={getDependencyChartData('duplicateDependencies')}
  valueFormat="count"
  yAxisLabel="Dependency count"
/>

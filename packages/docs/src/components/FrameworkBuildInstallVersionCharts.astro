---
import type { InstallChartMeasurement } from '../lib/types'
import {
  prepareColdBuildTimeHistory,
  prepareInstallTimeHistory,
  prepareWarmBuildTimeHistory,
} from '../lib/prepare-chart'
import VersionLineChart from './VersionLineChart.astro'

interface Props {
  versions: InstallChartMeasurement[]
}

const { versions } = Astro.props
---

<VersionLineChart {...prepareInstallTimeHistory(versions)} />
<VersionLineChart {...prepareColdBuildTimeHistory(versions)} />
<VersionLineChart {...prepareWarmBuildTimeHistory(versions)} />

---
import VersionLineChart from './VersionLineChart.astro'

interface Props {
  versions: unknown[]
}

const { versions } = Astro.props
---

<VersionLineChart
  title="Size of JS Files Containing Core-JS"
  description="Combined size of matching build output files, including any other code in those files."
  versions={versions}
  metric="vendoredCoreJsSize"
  transform="bytesToKb"
  valueFormat="kb"
  yAxisLabel="KB"
/>

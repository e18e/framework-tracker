---
import type { ChartMeasurement } from '../lib/types'
import {
  prepareDependencyInstallSizeHistory,
  prepareNodeModulesSizeHistory,
} from '../lib/prepare-chart'
import VersionLineChart from './VersionLineChart.astro'

interface Props {
  versions: ChartMeasurement[]
}

const { versions } = Astro.props
---

<VersionLineChart {...prepareNodeModulesSizeHistory(versions)} />
<VersionLineChart {...prepareDependencyInstallSizeHistory(versions)} />

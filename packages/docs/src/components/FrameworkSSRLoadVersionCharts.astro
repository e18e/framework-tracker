---
import type { ChartMeasurement } from '../lib/types'
import {
  prepareSSRLatencyHistory,
  prepareSSRTotalRequestsHistory,
} from '../lib/prepare-chart'
import VersionLineChart from './VersionLineChart.astro'

interface Props {
  versions: ChartMeasurement[]
  testsKey?: 'ssrLoadTests' | 'ssrRouterLinkLoadTests'
}

const { versions, testsKey = 'ssrLoadTests' } = Astro.props
const hasMeasurements = versions.some(
  (version) =>
    version != null && typeof version === 'object' && testsKey in version,
)
---

{
  hasMeasurements ? (
    <>
      <VersionLineChart
        {...prepareSSRTotalRequestsHistory(versions, testsKey)}
      />

      <VersionLineChart
        {...prepareSSRLatencyHistory(versions, 25, 'p99LatencyMs', testsKey)}
      />
      <VersionLineChart
        {...prepareSSRLatencyHistory(versions, 50, 'p99LatencyMs', testsKey)}
      />
      <VersionLineChart
        {...prepareSSRLatencyHistory(versions, 100, 'p99LatencyMs', testsKey)}
      />

      <VersionLineChart
        {...prepareSSRLatencyHistory(versions, 25, 'p90LatencyMs', testsKey)}
      />
      <VersionLineChart
        {...prepareSSRLatencyHistory(versions, 50, 'p90LatencyMs', testsKey)}
      />
      <VersionLineChart
        {...prepareSSRLatencyHistory(versions, 100, 'p90LatencyMs', testsKey)}
      />

      <VersionLineChart
        {...prepareSSRLatencyHistory(versions, 25, 'p75LatencyMs', testsKey)}
      />
      <VersionLineChart
        {...prepareSSRLatencyHistory(versions, 50, 'p75LatencyMs', testsKey)}
      />
      <VersionLineChart
        {...prepareSSRLatencyHistory(versions, 100, 'p75LatencyMs', testsKey)}
      />
    </>
  ) : (
    <p>No measurements available for this test.</p>
  )
}

---
import type { ChartMeasurement } from '../lib/types'
import {
  prepareSsrRequestThroughputTestsBodySizeKbHistory,
  prepareSsrRequestThroughputTestsMedianLatencyMsHistory,
  prepareSsrRequestThroughputTestsOpsPerSecHistory,
} from '../lib/prepare-chart'
import VersionLineChart from './VersionLineChart.astro'

interface Props {
  versions: ChartMeasurement[]
}

const { versions } = Astro.props
---

<VersionLineChart
  {...prepareSsrRequestThroughputTestsOpsPerSecHistory(versions)}
/>
<VersionLineChart
  {...prepareSsrRequestThroughputTestsBodySizeKbHistory(versions)}
/>
<VersionLineChart
  {...prepareSsrRequestThroughputTestsMedianLatencyMsHistory(versions)}
/>

---
import { formatChartValue } from '../lib/chart'
import { INTERACTION_PHASES } from '../lib/interaction-phases'
import InteractionChartCaption from './InteractionChartCaption.astro'

interface InteractionBreakdownDatum {
  name: string
  focused?: boolean
  interactionLatencyMs: number
  inputDelayMs: number
  processingDurationMs: number
  presentationDelayMs: number
}

interface Props {
  title: string
  data: InteractionBreakdownDatum[]
}

const { title, data } = Astro.props
const maxLatency = Math.max(
  1,
  ...data.map((datum) => datum.interactionLatencyMs),
)
const chartHeight = Math.max(80, data.length * 56 + 24)

function getMedian(values: number[]) {
  const sortedValues = [...values].sort((a, b) => a - b)
  const middleIndex = Math.floor(sortedValues.length / 2)

  return sortedValues.length % 2 === 0
    ? (sortedValues[middleIndex - 1]! + sortedValues[middleIndex]!) / 2
    : sortedValues[middleIndex]!
}

const medianLatency = getMedian(data.map((datum) => datum.interactionLatencyMs))
const focusedMedianLatency = getMedian(
  data
    .filter((datum) => datum.focused !== false)
    .map((datum) => datum.interactionLatencyMs),
)

function segmentSize(value: number) {
  return `${(value / maxLatency) * 100}%`
}

const FRAMEWORK_LOGOS: Record<string, { dark: string; light?: string }> = {
  Astro: {
    dark: '/framework-logos/astro-gradient.svg',
    light: '/framework-logos/astro-dark.svg',
  },
  'Baseline HTML': { dark: '/framework-logos/html5.svg' },
  Gatsby: { dark: '/framework-logos/gatsby.svg' },
  'Next.js': {
    dark: '/framework-logos/nextdotjs-light.svg',
    light: '/framework-logos/nextdotjs.svg',
  },
  Nuxt: { dark: '/framework-logos/nuxt.svg' },
  'Nuxt.js': { dark: '/framework-logos/nuxt.svg' },
  Pracht: { dark: '/framework-logos/pracht.svg' },
  'React Router': { dark: '/framework-logos/reactrouter.svg' },
  SolidStart: { dark: '/framework-logos/solid-start.svg' },
  SvelteKit: { dark: '/framework-logos/svelte.svg' },
  'TanStack Start': { dark: '/framework-logos/tanstack.svg' },
  WordPress: { dark: '/framework-logos/wordpress.svg' },
}
---

<figure class="interaction-chart">
  <InteractionChartCaption title={title} />
  <div
    class="horizontal-bars"
    style={`--interaction-chart-height: ${chartHeight}px`}
  >
    <div class="median-layer all-median" aria-hidden="true">
      <div class="median-plot">
        <span class="median-line" style={`left: ${segmentSize(medianLatency)}`}>
          <span class="median-label">
            Median: {formatChartValue(medianLatency, 'ms')}
          </span>
        </span>
      </div>
    </div>
    <div class="median-layer focused-median" aria-hidden="true">
      <div class="median-plot">
        <span
          class="median-line"
          style={`left: ${segmentSize(focusedMedianLatency)}`}
        >
          <span class="median-label">
            Median: {formatChartValue(focusedMedianLatency, 'ms')}
          </span>
        </span>
      </div>
    </div>
    {
      data.map((datum) => {
        const logo = FRAMEWORK_LOGOS[datum.name]
        return (
          <div
            class="horizontal-row"
            data-focused={datum.focused === false ? 'false' : 'true'}
          >
            <span class="framework-logo">
              {logo ? (
                <>
                  <img
                    class:list={{ 'theme-logo': true, dark: logo.light }}
                    src={logo.dark}
                    alt={datum.name}
                  />
                  {logo.light ? (
                    <img
                      class="theme-logo light"
                      src={logo.light}
                      alt={datum.name}
                    />
                  ) : null}
                </>
              ) : (
                <span class="logo-fallback" title={datum.name}>
                  {datum.name.slice(0, 1)}
                </span>
              )}
            </span>
            <div class="horizontal-plot">
              <div class="horizontal-bar" aria-hidden="true">
                {INTERACTION_PHASES.map(({ key, label, colorVar }) => (
                  <span
                    class="bar-segment"
                    style={`width: ${segmentSize(datum[key])}; background: var(${colorVar})`}
                    data-tooltip={`${label}: ${formatChartValue(datum[key], 'ms')}`}
                    title={`${label}: ${formatChartValue(datum[key], 'ms')}`}
                  />
                ))}
              </div>
              <strong
                class:list={{
                  'bar-value': true,
                  inside: datum.interactionLatencyMs / maxLatency > 0.85,
                }}
                style={`left: ${segmentSize(datum.interactionLatencyMs)}`}
              >
                {formatChartValue(datum.interactionLatencyMs, 'ms')}
              </strong>
            </div>
          </div>
        )
      })
    }
  </div>
  <div class="sr-only">
    <table>
      <caption>{title} data</caption>
      <thead>
        <tr>
          <th scope="col">Framework or version</th>
          <th scope="col">Interaction latency</th>
          {INTERACTION_PHASES.map(({ label }) => <th scope="col">{label}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          data.map((datum) => (
            <tr data-focused={datum.focused === false ? 'false' : 'true'}>
              <th scope="row">{datum.name}</th>
              <td>{formatChartValue(datum.interactionLatencyMs, 'ms')}</td>
              {INTERACTION_PHASES.map(({ key }) => (
                <td>{formatChartValue(datum[key], 'ms')}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</figure>

<style>
  .interaction-chart {
    width: 100%;
    margin: 0 0 2em;
  }

  .horizontal-bars {
    position: relative;
    display: flex;
    box-sizing: border-box;
    min-height: var(--interaction-chart-height);
    flex-direction: column;
    justify-content: space-evenly;
    gap: 0.75rem;
    padding-top: 24px;
  }

  .median-layer {
    position: absolute;
    z-index: 4;
    inset: 24px 0 0;
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 0.75rem;
    pointer-events: none;
  }

  .median-plot {
    position: relative;
    grid-column: 2;
  }

  .median-line {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
  }

  .median-line::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: linear-gradient(to bottom, #7bb560, #bece57, #f2ca60, #ec8f5e);
    mask: repeating-linear-gradient(to bottom, #000 0 5px, transparent 5px 9px);
    -webkit-mask: repeating-linear-gradient(
      to bottom,
      #000 0 5px,
      transparent 5px 9px
    );
    content: '';
  }

  .median-label {
    position: absolute;
    top: -20px;
    left: 0;
    color: var(--sl-color-text-accent);
    font-size: 0.75rem;
    font-weight: 600;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .focused-median {
    display: none;
  }

  :global([data-framework-scope='focused']) .all-median {
    display: none;
  }

  :global([data-framework-scope='focused']) .focused-median {
    display: grid;
  }

  .horizontal-row {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
  }

  .horizontal-row strong {
    color: var(--ft-muted);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }

  .framework-logo {
    display: grid;
    width: 1.25rem;
    height: 1.25rem;
    place-items: center;
  }

  .theme-logo {
    grid-area: 1 / 1;
    width: 1.25rem;
    height: 1.25rem;
    object-fit: contain;
  }

  .theme-logo.light {
    display: none;
  }

  :global(html[data-theme='light']) .theme-logo.dark {
    display: none;
  }

  :global(html[data-theme='light']) .theme-logo.light {
    display: block;
  }

  .logo-fallback {
    display: grid;
    width: 1.25rem;
    height: 1.25rem;
    place-items: center;
    border-radius: 50%;
    background: var(--ft-bg-muted);
    color: var(--ft-text);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .horizontal-plot {
    position: relative;
    width: 100%;
    height: 46px;
  }

  .horizontal-bar {
    position: absolute;
    inset: 0;
    display: flex;
    width: 100%;
    height: 46px;
  }

  .bar-value {
    position: absolute;
    z-index: 3;
    top: 50%;
    transform: translate(0.65rem, -50%);
    white-space: nowrap;
  }

  .bar-value.inside {
    color: var(--ft-chart-value-on-bar, #fff);
    transform: translate(calc(-100% - 0.65rem), -50%);
  }

  .bar-segment {
    position: relative;
    display: block;
    min-width: 1px;
  }

  .bar-segment::after {
    position: absolute;
    z-index: 10;
    bottom: calc(100% + 0.4rem);
    left: 50%;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--ft-border);
    border-radius: 0.35rem;
    background: var(--ft-text);
    color: var(--ft-bg);
    content: attr(data-tooltip);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 0.2rem);
    transition:
      opacity 120ms ease,
      transform 120ms ease;
    white-space: nowrap;
  }

  .bar-segment:hover {
    z-index: 2;
  }

  .bar-segment:hover::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .horizontal-bar .bar-segment:first-child {
    border-radius: 8px 0 0 8px;
  }

  .horizontal-bar .bar-segment:last-child {
    border-radius: 0 8px 8px 0;
  }

  :global([data-framework-scope='focused'])
    .horizontal-row[data-focused='false'],
  :global([data-framework-scope='focused']) .sr-only tr[data-focused='false'] {
    display: none;
  }

  @media screen and (max-width: 560px) {
    .horizontal-row {
      grid-template-columns: 1.5rem minmax(0, 1fr);
      gap: 0.5rem;
    }

    .median-layer {
      grid-template-columns: 1.5rem minmax(0, 1fr);
      gap: 0.5rem;
    }
  }
</style>

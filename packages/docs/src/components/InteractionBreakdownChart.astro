---
import { INTERACTION_PHASES } from '../lib/interaction-phases'
import InteractionChartCaption from './InteractionChartCaption.astro'
import StackedBarChart from './StackedBarChart.astro'

interface InteractionBreakdownDatum {
  name: string
  focused: boolean
  values: Record<string, number>
}

interface Props {
  title: string
  data: InteractionBreakdownDatum[]
}

const { title, data } = Astro.props
const series = INTERACTION_PHASES.map(({ key, label, colorVar }) => ({
  key,
  label,
  color: `var(${colorVar})`,
}))
---

<StackedBarChart {title} {series} {data} valueFormat="ms">
  <InteractionChartCaption slot="caption" {title} />
</StackedBarChart>

---
import {
  prepareLighthouseClientSideRenderedTestsFirstPaintMsComparison,
  prepareLighthouseClientSideRenderedTestsFirstPaintMsMonthlyComparison,
  runtimeHistory,
  ssrRequestThroughputStats,
} from '../lib/prepare-chart'
import ComparisonComposition from './ComparisonComposition.astro'

const bar = prepareLighthouseClientSideRenderedTestsFirstPaintMsComparison(
  ssrRequestThroughputStats,
)
const line = prepareLighthouseClientSideRenderedTestsFirstPaintMsMonthlyComparison(
  runtimeHistory,
  ssrRequestThroughputStats,
)
---

<ComparisonComposition bar={bar} line={line} />

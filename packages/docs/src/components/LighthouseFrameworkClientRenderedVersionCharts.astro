---
import type { ChartMeasurement } from '../lib/types'
import {
  prepareLighthouseClientSideRenderedTestsFcpMsHistory,
  prepareLighthouseClientSideRenderedTestsFirstPaintMsHistory,
  prepareLighthouseClientSideRenderedTestsInteractionHistory,
} from '../lib/prepare-chart'
import VersionLineChart from './VersionLineChart.astro'
import InteractionHistoryChart from './InteractionHistoryChart.astro'

interface Props {
  versions: ChartMeasurement[]
}

const { versions } = Astro.props

const interactionData =
  prepareLighthouseClientSideRenderedTestsInteractionHistory(versions)
---

<VersionLineChart
  {...prepareLighthouseClientSideRenderedTestsFirstPaintMsHistory(versions)}
/>
<VersionLineChart {...prepareLighthouseClientSideRenderedTestsFcpMsHistory(versions)} />
{
  interactionData.length > 0 ? (
    <InteractionHistoryChart
      title="Client Interaction Breakdown by Version (Lighthouse)"
      data={interactionData}
    />
  ) : null
}

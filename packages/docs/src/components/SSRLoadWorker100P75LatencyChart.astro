---
import {
  prepareSSRLatencyComparison,
  prepareSSRLatencyMonthlyComparison,
  runtimeHistory,
  ssrRequestThroughputStats,
  type SSRLoadKey,
} from '../lib/prepare-chart'
import ComparisonComposition from './ComparisonComposition.astro'

interface Props {
  testsKey?: SSRLoadKey
}
const { testsKey = 'ssrLoadTests' } = Astro.props
const bar = prepareSSRLatencyComparison(
  ssrRequestThroughputStats,
  100,
  'p75LatencyMs',
  testsKey,
)
const line = prepareSSRLatencyMonthlyComparison(
  runtimeHistory,
  ssrRequestThroughputStats,
  100,
  'p75LatencyMs',
  testsKey,
)
---

<ComparisonComposition bar={bar} line={line} />

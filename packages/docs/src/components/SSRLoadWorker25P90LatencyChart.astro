---
import {
  ssrRequestThroughputStats,
  type SSRLoadKey,
} from '../lib/prepare-chart'
import { prepareSSRLatencyComparison } from '../lib/prepare-chart'
import ComparisonBarChart from './ComparisonBarChart.astro'

interface Props {
  testsKey?: SSRLoadKey
}
const { testsKey = 'ssrLoadTests' } = Astro.props
const chart = prepareSSRLatencyComparison(
  ssrRequestThroughputStats,
  25,
  'p90LatencyMs',
  testsKey,
)
---

<ComparisonBarChart {...chart} />

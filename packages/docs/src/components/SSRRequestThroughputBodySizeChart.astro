---
import {
  prepareSsrRequestThroughputTestsBodySizeKbComparison,
  prepareSsrRequestThroughputTestsBodySizeKbMonthlyComparison,
  runtimeHistory,
  ssrRequestThroughputStats,
} from '../lib/prepare-chart'
import ComparisonComposition from './ComparisonComposition.astro'

const bar = prepareSsrRequestThroughputTestsBodySizeKbComparison(
  ssrRequestThroughputStats,
)
const line = prepareSsrRequestThroughputTestsBodySizeKbMonthlyComparison(
  runtimeHistory,
  ssrRequestThroughputStats,
)
---

<ComparisonComposition bar={bar} line={line} />

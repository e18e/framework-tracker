---
import {
  prepareSsrRequestThroughputTestsLatencyMsComparison,
  prepareSsrRequestThroughputTestsLatencyMsMonthlyComparison,
  runtimeHistory,
  ssrRequestThroughputStats,
} from '../lib/prepare-chart'
import ComparisonComposition from './ComparisonComposition.astro'


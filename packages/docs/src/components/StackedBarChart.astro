---
import { SHARED_CHART_HEIGHT, formatChartValue } from '../lib/chart'
import type { ChartValueFormat } from '../lib/types'
interface Series {
  key: string
  label: string
  color: string
}
interface Datum {
  name: string
  values: Record<string, number>
}
interface Props {
  title: string
  series: Series[]
  data: Datum[]
  valueFormat?: ChartValueFormat
}
const { title, series, data, valueFormat = 'kb' } = Astro.props
---

<figure>
  <slot name="caption" />
  {
    !Astro.slots.has('caption') && (
      <ul class="legend" aria-label="Chart series">
        {series.map((item) => (
          <li>
            <span style={`background: ${item.color}`} />
            {item.label}
          </li>
        ))}
      </ul>
    )
  }
  <div
    class="stacked-chart"
    data-stacked={JSON.stringify({ title, series, data, valueFormat })}
    style={`--chart-height: ${SHARED_CHART_HEIGHT}px`}
  >
    <div class="chart-host"></div>
    <div class="logo-layer" aria-hidden="true"></div>
  </div>
  <div class="sr-only">
    <table>
      <caption>{title} data</caption>
      <thead
        ><tr
          ><th scope="col">Framework</th>{
            series.map((item) => <th scope="col">{item.label}</th>)
          }</tr
        ></thead
      >
      <tbody
        >{
          data.map((row) => (
            <tr>
              <th scope="row">{row.name}</th>
              {series.map((item) => (
                <td>{formatChartValue(row.values[item.key]!, valueFormat)}</td>
              ))}
            </tr>
          ))
        }</tbody
      >
    </table>
  </div>
</figure>
<style>
  figure {
    margin: 0 0 2em;
    width: 100%;
  }
  .stacked-chart {
    position: relative;
    min-height: var(--chart-height);
  }
  .stacked-chart :global(.ts-chart:focus:not(:focus-visible)) {
    outline: none;
  }
  .logo-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    margin: 0;
  }
  .logo-layer :global(img),
  .logo-layer :global(.logo-fallback) {
    position: absolute;
    width: 20px;
    height: 20px;
    margin: 0;
    object-fit: contain;
    transform: translate(-100%, -50%);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }
  .legend li {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    margin: 0;
  }
  .legend span {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 2px;
    border: 1px solid var(--ft-border);
  }
</style>
<script>
  import {
    rect,
    defineChart,
    mountChart,
    text,
    type ChartHost,
    type ChartRenderContext,
  } from '@tanstack/charts'
  import { scaleBand } from '@tanstack/charts/scales/band'
  import { scaleLinear } from '@tanstack/charts/scales/linear'
  import { tooltip } from '@tanstack/charts/tooltip'
  import {
    SHARED_BAR_INSET,
    SHARED_CHART_HEIGHT,
    formatChartValue,
    getFrameworkLogoSource,
  } from '../lib/chart'
  import type { ChartValueFormat } from '../lib/types'
  interface Segment {
    name: string
    label: string
    value: number
    start: number
    end: number
    color: string
    total: number
  }
  interface Payload {
    title: string
    valueFormat: ChartValueFormat
    series: { key: string; label: string; color: string }[]
    data: { name: string; values: Record<string, number> }[]
  }
  const hosts = new WeakMap<HTMLElement, ChartHost<Segment, number, string>>()
  function initCharts() {
    document
      .querySelectorAll<HTMLElement>('[data-stacked]')
      .forEach((element) => {
        const payload = JSON.parse(element.dataset.stacked!) as Payload
        const totalFor = (row: Payload['data'][number]) =>
          payload.series.reduce((sum, item) => sum + row.values[item.key]!, 0)
        const rows = payload.data.sort((a, b) => totalFor(a) - totalFor(b))
        if (!rows.length) return
        const segments = rows.flatMap((row) => {
          let offset = 0
          const total = payload.series.reduce(
            (sum, item) => sum + row.values[item.key]!,
            0,
          )
          return payload.series.map((item) => {
            const value = row.values[item.key]!
            const segment = {
              name: row.name,
              label: item.label,
              value,
              start: offset,
              end: offset + value,
              color: item.color,
              total,
            }
            offset += value
            return segment
          })
        })
        const labels = segments.filter(
          (segment) => segment.label === payload.series[0]!.label,
        )
        const max = Math.max(1, ...labels.map((d) => d.total))
        const logoLayer = element.querySelector<HTMLElement>('.logo-layer')!
        logoLayer.replaceChildren(
          ...rows.map((row) => {
            const source = getFrameworkLogoSource(row.name)
            const logo = document.createElement(source ? 'img' : 'span')
            if (logo instanceof HTMLImageElement) {
              logo.src = source!
              logo.alt = row.name
            } else {
              logo.className = 'logo-fallback'
              logo.textContent = row.name.slice(0, 1)
            }
            logo.title = row.name
            return logo
          }),
        )
        const muted =
          getComputedStyle(document.documentElement)
            .getPropertyValue('--ft-muted')
            .trim() || '#697586'
        const format = (value: number) =>
          formatChartValue(value, payload.valueFormat)
        const definition = defineChart({
          margin: { left: 36, right: 0, top: 12, bottom: 0 },
          focusRing: false,
          marks: [
            ...segments
              .filter((d) => d.value > 0)
              .map((d) =>
                rect([d], {
                  x1: 'start',
                  x2: 'end',
                  y: 'name',
                  fill: d.color.startsWith('var(')
                    ? getComputedStyle(document.documentElement)
                        .getPropertyValue(d.color.slice(4, -1))
                        .trim() || muted
                    : d.color,
                  inset: SHARED_BAR_INSET,
                  radius: [
                    d.start === 0 ? 8 : 0,
                    d.end === d.total ? 8 : 0,
                    d.end === d.total ? 8 : 0,
                    d.start === 0 ? 8 : 0,
                  ],
                }),
              ),
            text(labels, {
              x: 'total',
              y: 'name',
              text: (d) => format(d.total),
              anchor: (d) => (d.total / max > 0.85 ? 'end' : 'start'),
              dx: (d) => (d.total / max > 0.85 ? -10 : 10),
              fill: (d) =>
                d.total / max > 0.85
                  ? segments.findLast(
                      (segment) => segment.name === d.name && segment.value > 0,
                    )?.color === '#f7df1e'
                    ? '#203329'
                    : '#fff'
                  : muted,
              fontWeight: 600,
              fontSize: 13,
            }),
          ],
          scales: {
            x: {
              scale: () =>
                scaleLinear().domain([
                  0,
                  Math.max(1, ...labels.map((d) => d.total)),
                ]),
              axis: false,
            },
            y: {
              scale: () =>
                scaleBand<string>()
                  .domain(rows.map((d) => d.name))
                  .padding(0.18),
              axis: false,
            },
          },
          tooltip: {
            use: tooltip,
            content: (points) => ({
              title: points[0]!.datum.name,
              rows: [
                { label: 'Total', value: format(points[0]!.datum.total) },
                ...segments
                  .filter((segment) => segment.name === points[0]!.datum.name)
                  .map((segment) => ({
                    label: segment.label,
                    value: format(segment.value),
                    color: segment.color,
                  })),
              ],
            }),
          },
        })
        const options = {
          definition,
          height: SHARED_CHART_HEIGHT,
          onRender: ({
            scene,
          }: ChartRenderContext<Segment, number, string>) => {
            Array.from(logoLayer.children).forEach((child, index) => {
              const logo = child as HTMLElement
              logo.style.left = `${scene.chart.x - 12}px`
              logo.style.top = `${scene.scales.y!.map(rows[index]!.name)}px`
            })
          },
          ariaLabel: `${payload.title}. Stacked bar chart; a data table follows.`,
        }
        const host = hosts.get(element)
        if (host) host.update(options)
        else
          hosts.set(
            element,
            mountChart(
              element.querySelector<HTMLElement>('.chart-host')!,
              options,
            ),
          )
      })
  }
  if (document.readyState === 'loading')
    document.addEventListener('DOMContentLoaded', initCharts)
  else initCharts()
  new MutationObserver(() => requestAnimationFrame(initCharts)).observe(
    document.documentElement,
    { attributes: true, attributeFilter: ['class', 'data-theme'] },
  )
</script>

---
type Row = Record<string, unknown>

export interface TableColumn {
  key: string
  header: string
  nameCell?: boolean
  href?: (row: Row) => string | null | undefined
  alignment?: 'center' | 'left' | 'right'
}

interface Props {
  label: string
  columns: TableColumn[]
  data: Row[]
}

const { label, columns, data } = Astro.props
---

<div class="wrapper">
  <table aria-label={label}>
    <thead>
      <tr>
        {
          columns.map(({ alignment = 'center', header }) => (
            <th scope="col" class={`${alignment}-column`}>
              {header}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        data.map((row) => (
          <tr>
            {columns.map(({ key, alignment = 'center', href, nameCell }) => {
              const url = href?.(row)
              return (
                <td
                  class:list={[
                    `${alignment}-column`,
                    nameCell ? 'name-cell' : undefined,
                  ]}
                >
                  {url ? (
                    <a href={url} class="table-link">
                      {String(row[key] ?? '')}
                    </a>
                  ) : (
                    String(row[key] ?? '')
                  )}
                </td>
              )
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .wrapper {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-top: 16px;
    margin-bottom: 2em;
  }

  table {
    width: 100%;
    min-width: max-content;
    border-collapse: collapse;
    background: var(--ft-bg);
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--ft-border);
  }

  thead {
    background: var(--ft-bg-muted);
    color: var(--ft-text);
  }

  th {
    padding: 16px;
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .left-column {
    text-align: left;
  }

  .center-column {
    text-align: center;
  }

  .right-column {
    text-align: right;
  }

  td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--ft-border);
    font-size: 15px;
    color: var(--ft-muted);
    white-space: nowrap;
  }

  td.name-cell {
    font-weight: 500;
    color: var(--ft-text);
  }

  tbody tr:last-child td {
    border-bottom: none;
  }

  tbody tr:hover {
    background: color-mix(in srgb, var(--ft-accent-hover), transparent 96%);
  }

  .table-link {
    color: var(--ft-accent);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .table-link:hover {
    color: var(--ft-accent-hover);
    text-decoration: underline;
  }

  /* Responsive */
  @media screen and (max-width: 768px) {
    th,
    td {
      padding: 12px 8px;
      font-size: 13px;
    }

    th {
      font-size: 12px;
    }
  }
</style>

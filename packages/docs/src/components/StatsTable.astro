---
type Row = Record<string, unknown>

export interface TableColumn {
  key: string
  header: string
  nameCell?: boolean
  href?: (row: Row) => string | null | undefined
  alignment?: 'center' | 'left' | 'right'
}

interface Props {
  label: string
  columns: TableColumn[]
  data: Row[]
}

const { label, columns, data } = Astro.props
---

<div class="table-scroll">
  <table aria-label={label}>
    <thead>
      <tr>
        {
          columns.map(({ alignment = 'center', header }) => (
            <th scope="col" class={`${alignment}-column`}>
              {header}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        data.map((row) => (
          <tr>
            {columns.map(({ key, alignment = 'center', href, nameCell }) => {
              const url = href?.(row)
              const value = String(row[key] ?? '')
              const content = url ? <a href={url}>{value}</a> : value
              return (
                <td class={`${alignment}-column`}>
                  {nameCell ? <strong>{content}</strong> : content}
                </td>
              )
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .table-scroll {
    margin-block: 1rem 2rem;
    overflow-x: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
  }

  table {
    display: table;
    width: 100%;
    border-collapse: collapse;
    white-space: nowrap;
  }

  thead {
    background: var(--sl-color-gray-6);
  }

  th {
    padding: 1rem;
    text-transform: uppercase;
  }

  td {
    padding: 0.875rem 1rem;
  }

  tbody tr:last-child td {
    border-bottom: 0;
  }

  .left-column {
    text-align: left;
  }

  .center-column {
    text-align: center;
  }

  .right-column {
    text-align: right;
  }

  @media (max-width: 48rem) {
    th,
    td {
      padding: 0.75rem 0.5rem;
    }
  }
</style>

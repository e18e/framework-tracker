---
import { formatChartValue } from '../lib/chart'
import type { VersionLineChartPayload } from '../lib/types'

type Props = VersionLineChartPayload

const CHART_HEIGHT_PX = 340
const MOBILE_CHART_HEIGHT_PX = 260
const {
  title,
  description,
  data: chartData,
  valueFormat,
  yAxisLabel,
} = Astro.props
const chartPayload = JSON.stringify(Astro.props)

function formatLatestChange(value: number | null) {
  if (value == null) return null
  if (value === 0) return 'No change'
  return `${value > 0 ? '+' : '−'}${formatChartValue(Math.abs(value), valueFormat)}`
}

const hasChartData = chartData.some((d) => d.value != null)
const latestDatum = chartData.at(-1)
const previousDatum = chartData.at(-2)
const latestChange =
  latestDatum?.value != null && previousDatum?.value != null
    ? latestDatum.value - previousDatum.value
    : null
const latestChangeLabel = formatLatestChange(latestChange)
---

{
  hasChartData ? (
    <figure class="version-line-chart">
      <figcaption class="version-line-chart-heading">
        <div>
          <p class="version-line-chart-title">{title}</p>
          {description ? <p>{description}</p> : null}
        </div>
        {latestDatum?.value != null ? (
          <div class="version-line-chart-latest">
            <span class="version-line-chart-latest-label">
              Latest · v{latestDatum.name}
            </span>
            <strong>{formatChartValue(latestDatum.value, valueFormat)}</strong>
            {latestChangeLabel ? (
              <span class="version-line-chart-change">
                {latestChangeLabel} from previous
              </span>
            ) : null}
          </div>
        ) : null}
      </figcaption>
      <div class="version-line-chart-wrapper" data-version-line={chartPayload}>
        <div class="version-line-chart-host" />
        <div class="version-line-chart-data sr-only">
          <table>
            <caption>{title} data</caption>
            <thead>
              <tr>
                <th scope="col">Framework version</th>
                <th scope="col">{yAxisLabel}</th>
              </tr>
            </thead>
            <tbody>
              {chartData.map((datum) => (
                <tr>
                  <th scope="row">{datum.name}</th>
                  <td>
                    {datum.value == null
                      ? '—'
                      : formatChartValue(datum.value, valueFormat)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <p>
            The latest release is shown as a filled point; earlier releases use
            outlined points.
          </p>
        </div>
      </div>
    </figure>
  ) : (
    <p>No measurements available for this test.</p>
  )
}

<style
  define:vars={{
    chartHeight: `${CHART_HEIGHT_PX}px`,
    mobileChartHeight: `${MOBILE_CHART_HEIGHT_PX}px`,
  }}
>
  .version-line-chart {
    width: 100%;
    margin-block: 1.5rem 2.5rem;
    margin-inline: 0;
  }

  .version-line-chart-title {
    margin: 0;
    color: var(--sl-color-white);
    font-size: 1rem;
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
  }

  .version-line-chart-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .version-line-chart-heading p:not(.version-line-chart-title) {
    margin-block: 0.35rem 0;
  }

  .version-line-chart-latest {
    display: grid;
    flex: 0 0 auto;
    grid-template-columns: auto auto;
    align-items: baseline;
    column-gap: 0.75rem;
    text-align: right;
  }

  .version-line-chart-latest-label {
    color: var(--ft-muted);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .version-line-chart-latest strong {
    color: var(--ft-text);
    font-size: 1.1rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .version-line-chart-change {
    grid-column: 1 / -1;
    color: var(--ft-muted);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .version-line-chart-wrapper {
    position: relative;
    box-sizing: border-box;
    width: 100%;
    max-width: 1000px;
    height: var(--chartHeight);
    margin-inline: auto;
    padding: 1rem 1rem 0.5rem 0.5rem;
    border: 1px solid var(--ft-border);
    border-radius: 0.75rem;
    background: var(--ft-bg);
    box-shadow: 0 1px 0 rgb(0 0 0 / 4%);
  }

  @media (max-width: 768px) {
    .version-line-chart-heading {
      display: block;
    }

    .version-line-chart-latest {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-start;
      margin-top: 0.65rem;
      column-gap: 0.5rem;
    }

    .version-line-chart-change {
      flex-basis: 100%;
    }

    .version-line-chart-wrapper {
      height: var(--mobileChartHeight);
      padding: 0.75rem 0.5rem 0.25rem 0.25rem;
    }
  }
</style>

<script>
  import {
    areaY,
    crosshair,
    defineChart,
    dot,
    lineY,
    mountChart,
    type ChartHost,
  } from '@tanstack/charts'
  import { decorative } from '@tanstack/charts/mark/decorative'
  import { scaleLinear } from '@tanstack/charts/scales/linear'
  import { scalePoint } from '@tanstack/charts/scales/point'
  import { tooltip } from '@tanstack/charts/tooltip'
  import { formatChartValue } from '../lib/chart'
  import type { VersionLineChartPayload } from '../lib/types'

  type Datum = VersionLineChartPayload['data'][number]
  const hosts = new WeakMap<HTMLElement, ChartHost<Datum, string, number>>()
  const mobileViewport = window.matchMedia('(max-width: 768px)')
  function css(name: string, fallback: string) {
    return (
      getComputedStyle(document.documentElement)
        .getPropertyValue(name)
        .trim() || fallback
    )
  }
  function initChart(wrapper: HTMLElement) {
    let payload: VersionLineChartPayload
    try {
      payload = JSON.parse(wrapper.dataset.versionLine ?? '')
    } catch (error) {
      console.warn('[VersionLineChart] Invalid chart data:', error)
      return
    }
    const { data, valueFormat } = payload
    if (!data.some((datum) => datum.value != null)) return
    const line = css('--ft-chart-line', '#697586')
    const latest = data.at(-1)
    const definition = defineChart({
      gradients: [
        {
          id: 'version-line-fill',
          x1: 0,
          y1: 0,
          x2: 0,
          y2: 1,
          stops: [
            { offset: 0, color: line, opacity: 0.12 },
            { offset: 0.72, color: line, opacity: 0 },
          ],
        },
      ],
      margin: { top: 12 },
      focusRing: false,
      marks: [
        decorative(
          areaY(data, {
            x: 'name',
            y: 'value',
            y1: 0,
            fill: 'url(#version-line-fill)',
            fillOpacity: 1,
          }),
        ),
        decorative(
          lineY(data, { x: 'name', y: 'value', stroke: line, strokeWidth: 3 }),
        ),
        dot(
          data.filter((datum) => datum !== latest),
          {
            x: 'name',
            y: 'value',
            r: 4,
            fill: css('--ft-bg', '#ffffff'),
            stroke: line,
            strokeWidth: 3,
          },
        ),
        dot(latest ? [latest] : [], {
          x: 'name',
          y: 'value',
          r: 6,
          fill: css('--ft-chart-line-hover', '#4b5565'),
          stroke: line,
          strokeWidth: 3,
        }),
        crosshair({ x: true, y: false }),
      ],
      scales: {
        x: {
          scale: scalePoint<string>()
            .domain(data.map((datum) => datum.name))
            .padding(0.1),
          axis: {
            tickLabels: {
              fontSize: 12,
              fontWeight: 500,
              opacity: 1,
              rotate: data.length > 8 ? -45 : undefined,
            },
          },
        },
        y: {
          scale: scaleLinear().domain([
            0,
            Math.max(1, ...data.map((datum) => datum.value ?? 0)) * 1.05,
          ]),
          nice: true,
          grid: { stroke: css('--ft-chart-grid', '#d9dee7'), strokeOpacity: 1 },
          axis: {
            label: payload.yAxisLabel,
            tickLabels: { fontSize: 12, fontWeight: 500, opacity: 1 },
            ticks: {
              format: (value: string | number | Date) =>
                valueFormat === 'count' && !Number.isInteger(Number(value))
                  ? ''
                  : formatChartValue(Number(value), valueFormat),
            },
          },
        },
      },
      theme: {
        muted: css('--ft-text', '#1f2933'),
        grid: css('--ft-chart-grid', '#d9dee7'),
      },
      focus: 'nearest-x',
      maxFocusDistance: Number.POSITIVE_INFINITY,
      tooltip: {
        use: tooltip,
        content: (points) => ({
          title: `Version ${points[0]!.datum.name}`,
          rows: [
            {
              label: payload.yAxisLabel,
              value: formatChartValue(points[0]!.datum.value!, valueFormat),
            },
          ],
        }),
      },
    })
    const options = {
      definition,
      height: mobileViewport.matches ? 230 : 300,
      ariaLabel: `${payload.title}. Line chart by framework version; a data table follows.`,
    }
    const existing = hosts.get(wrapper)
    if (existing) existing.update(options)
    else
      hosts.set(
        wrapper,
        mountChart(
          wrapper.querySelector<HTMLElement>('.version-line-chart-host')!,
          options,
        ),
      )
  }
  function initCharts() {
    document
      .querySelectorAll<HTMLElement>('.version-line-chart-wrapper')
      .forEach(initChart)
  }
  if (document.readyState === 'loading')
    document.addEventListener('DOMContentLoaded', initCharts)
  else initCharts()
  mobileViewport.addEventListener('change', initCharts)
  new MutationObserver(() => requestAnimationFrame(initCharts)).observe(
    document.documentElement,
    { attributeFilter: ['class', 'data-theme'], attributes: true },
  )
</script>

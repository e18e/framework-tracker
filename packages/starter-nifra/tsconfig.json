{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "rootDirs": [".", "./.nifra/types"],
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["bun", "react", "react-dom"],
    "verbatimModuleSyntax": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist", ".nifra", ".nifra-build", ".vercel"]
}
